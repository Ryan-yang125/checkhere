{
  "name": "checkhere",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "tsc -b",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "cli": "tsx packages/cli/src/index.ts",
    "api:dev": "wrangler dev apps/api/src/index.ts --config apps/api/wrangler.jsonc",
    "api:deploy": "npm run build && wrangler deploy --config apps/api/wrangler.jsonc",
    "pack:cli": "npm run build -w checkhere && npm pack -w checkhere",
    "api:types": "wrangler types apps/api/src/worker-configuration.d.ts --config apps/api/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
