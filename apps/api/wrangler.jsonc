{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "checkhere-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-26",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "checkhere.page", "custom_domain": true }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://checkhere.page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
